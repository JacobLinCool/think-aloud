    },
    "ThinkAloud found a partially committed deletion at %@. %lld record(s) still exist and %lld are missing. Keep this folder unchanged and restore from backup or contact support.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "ThinkAloud found a partially committed deletion at %1$@. %2$lld record(s) still exist and %3$lld are missing. Keep this folder unchanged and restore from backup or contact support."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "ThinkAloud 在 %@ 發現部分提交的刪除作業。仍有 %lld 筆紀錄存在，%lld 筆紀錄已不存在。請保持此檔案夾原狀，並從備份還原或聯絡支援人員。"
          }
        }
      }
    },
    "ThinkAloud found an invalid interrupted-deletion batch at %@. Keep this folder unchanged and restore it from backup or contact support. %@": {
