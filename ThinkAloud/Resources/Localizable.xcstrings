    },
    "The file size is unavailable.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法取得檔案大小。"
          }
        }
      }
    },
    "The in-memory recovery identity does not match the durable manifest.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "記憶體中的復原識別資料與持久保存的復原資訊檔不符。"
          }
        }
      }
    },
    "The interrupted-save recovery folder at %@ is invalid. Keep it unchanged and check its permissions. %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "The interrupted-save recovery folder at %1$@ is invalid. Keep it unchanged and check its permissions. %2$@"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "位於 %@ 的中斷儲存復原檔案夾無效。請保持原狀並檢查其權限。%@"
          }
        }
      }
    },
    "The manifest filename does not match its record identifier.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "復原資訊檔的檔名與其紀錄識別碼不符。"
          }
        }
      }
    },
    "The manifest is not a direct, non-symbolic-link JSON file.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "復原資訊檔並非直接位於預期位置的非符號連結 JSON 檔案。"
          }
        }
      }
    },
    "The microphone’s audio format isn’t supported. Choose another input device and try again.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "麥克風的音訊格式不受支援。請選擇其他輸入裝置後再試一次。"
          }
        }
      }
    },
    "The model couldn’t be downloaded. Check your connection and available storage, then try again.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法下載模型。請檢查網路連線與可用儲存空間後再試一次。"
          }
        }
      }
    },
    "The model test couldn’t finish. Check the model, your connection, and available storage, then try again.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "模型測試無法完成。請檢查模型、網路連線與可用儲存空間後再試一次。"
          }
        }
      }
    },
    "The recording couldn’t be loaded. Verify the audio file, then try again.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法載入錄音。請確認音訊檔後再試一次。"
          }
        }
      }
    },
    "The recording couldn’t be played. Verify the audio file, then try again.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法播放錄音。請確認音訊檔後再試一次。"
          }
        }
      }
    },
    "The recording identifier is empty or contains a path separator.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "錄音識別碼不可為空，也不可包含路徑分隔符號。"
          }
        }
      }
    },
    "The recording’s audio file is unavailable. Refresh the dataset after restoring the file.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "錄音的音訊檔無法使用。還原檔案後，請重新整理資料集。"
          }
        }
      }
    },
    "The recovery batch is not a direct, non-symbolic-link directory.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "復原批次並非直接位於預期位置的非符號連結目錄。"
          }
        }
      }
    },
    "The recovery copy is missing.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "找不到復原副本。"
          }
        }
      }
    },
    "The recovery manifest contains duplicate or inconsistent records and audio paths.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "復原資訊檔包含重複或不一致的紀錄與音訊路徑。"
          }
        }
      }
    },
    "The recovery manifest is not a regular file inside its batch.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "復原資訊檔不是其批次中的一般檔案。"
          }
        }
      }
    },
    "The recovery manifest version is unsupported.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "不支援此復原資訊檔版本。"
          }
        }
      }
    },
    "The recovery root must be a non-symbolic-link directory.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "復原根目錄必須是非符號連結的目錄。"
          }
        }
      }
    },
    "The refinement model isn’t ready. Open AI Refine settings and try again.": {
