{
  "sourceLanguage": "en",
  "strings": {
    "%@ / %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ / %2$@"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@／%@"
          }
        }
      }
    },
    "%@ Temporary upload files also could not be removed. Remove %@ manually. %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ Temporary upload files also could not be removed. Remove %2$@ manually. %3$@"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 也無法移除上傳暫存檔。請手動移除 %@。%@"
          }
        }
      }
    },
    "%@ ThinkAloud also couldn’t save the recording to the local dataset or remove its temporary audio. This recovery remains open: choose Retry Save, or check Dataset settings, file permissions, and available disk space before choosing Close again.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ThinkAloud 也無法將錄音儲存至本機資料集或移除其暫存音訊。此復原作業仍待處理：請選擇「重試儲存」，或先檢查「資料集」設定、檔案權限與可用磁碟空間，再次選擇「關閉」。"
          }
        }
      }
    },
    "%@ ThinkAloud also couldn’t save the recording to the local dataset. Check Dataset settings and available disk space, then retry.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ThinkAloud 也無法將錄音儲存至本機資料集。請檢查「資料集」設定與可用磁碟空間後再試一次。"
          }
        }
      }
    },
    "%@ of %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ of %2$@"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@／%@"
          }
        }
      }
    },
    "%@ records": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 筆紀錄"
          }
        }
      }
    },
    "%@ records selected": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已選取 %@ 筆紀錄"
          }
        }
      }
    },
    "%@ selected": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已選取 %@"
          }
        }
      }
    },
    "%@ · %@ · %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ · %2$@ · %3$@"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ · %@ · %@"
          }
        }
      }
    },
    "%lld": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld"
          }
        }
      }
    },
    "%lld / %lld": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$lld / %2$lld"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld／%lld"
          }
        }
      }
    },
    "%lld active days": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "活躍 %lld 天"
          }
        }
      }
    },
    "%lld of %lld": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$lld of %2$lld"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld／%lld"
          }
        }
      }
    },
    "%lld of %lld inserted with no edits": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld／%lld 筆未經編輯即插入"
          }
        }
      }
    },
    "%lld record(s) were removed, but deletion is incomplete because recovery files could not be purged. Remove this folder manually: %@. %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$lld record(s) were removed, but deletion is incomplete because recovery files could not be purged. Remove this folder manually: %2$@. %3$@"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 筆紀錄已移除，但因無法清除復原檔案，刪除作業尚未完成。請手動移除此檔案夾：%@。%@"
          }
        }
      }
    },
    "%lld recordings": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 筆錄音"
          }
        }
      }
    },
    "%lld sessions": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 次"
          }
        }
      }
    },
    "%lld timed · %lld without a length": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 筆有長度 · %lld 筆無長度"
          }
        }
      }
    },
    "%lld to %@ sessions": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "再 %lld 次達到 %@"
          }
        }
      }
    },
    "%lld-day streak": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "連續 %lld 天"
          }
        }
      }
    },
    "(empty)": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "（空）"
          }
        }
      }
    },
    "(your namespace)": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "（留空使用個人帳號）"
          }
        }
      }
    },
    "0–2 sec": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "0–2 秒"
          }
        }
      }
    },
    "1 hour": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "1 小時"
          }
        }
      }
    },
    "10 minutes": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "10 分鐘"
          }
        }
      }
    },
    "100% local. Your audio never leaves your Mac.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "100% 本機運算，音訊絕不離開你的 Mac。"
          }
        }
      }
    },
    "10–20 sec": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "10–20 秒"
          }
        }
      }
    },
    "20–30 sec": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "20–30 秒"
          }
        }
      }
    },
    "2–5 sec": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "2–5 秒"
          }
        }
      }
    },
    "30 minutes": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "30 分鐘"
          }
        }
      }
    },
    "30–60 sec": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "30–60 秒"
          }
        }
      }
    },
    "5 minutes": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "5 分鐘"
          }
        }
      }
    },
    "5–10 sec": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "5–10 秒"
          }
        }
      }
    },
    "60+ sec": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "60 秒以上"
          }
        }
      }
    },
    "A Hugging Face token lets you push the dataset from the browser window. It is stored in the macOS Keychain.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Hugging Face 權杖可讓你從資料集瀏覽器視窗推送資料集，並儲存於 macOS 鑰匙圈。"
          }
        }
      }
    },
    "A metadata row could not be encoded as UTF-8.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法將其中一筆中繼資料編碼為 UTF-8。"
          }
        }
      }
    },
    "A recovery file already exists at %@.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "復原檔案已存在於 %@。"
          }
        }
      }
    },
    "A reliable balance of quality and speed. Recommended.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在品質與速度間取得可靠平衡。建議使用。"
          }
        }
      }
    },
    "A small popup appears. Start talking.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "會出現一個小視窗，開始說話即可。"
          }
        }
      }
    },
    "A solid middle ground between speed and accuracy.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在速度與準確度間取得良好平衡。"
          }
        }
      }
    },
    "A token is saved. Paste a new one to replace it.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已儲存權杖。貼上新的權杖即可取代。"
          }
        }
      }
    },
    "AI Refine": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "AI 潤飾"
          }
        }
      }
    },
    "AI refinement failed. The unrefined transcript is shown; verify the selected refinement engine and try again.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "AI 潤飾失敗。畫面顯示的是未潤飾的逐字稿；請確認所選潤飾引擎後再試一次。"
          }
        }
      }
    },
    "AI refinement returned no usable text. The unrefined transcript is shown.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "AI 潤飾未傳回可用文字。畫面顯示的是未潤飾的逐字稿。"
          }
        }
      }
    },
    "Accessibility (Optional)": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "輔助使用（選用）"
          }
        }
      }
    },
    "Accessibility off — text will be copied to the clipboard": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "未開啟輔助使用，文字將複製到剪貼簿"
          }
        }
      }
    },
    "Accessibility permission is required to paste text into other apps.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "需要「輔助使用」權限，才能將文字貼入其他 App。"
          }
        }
      }
    },
    "Accessibility · Optional": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "輔助使用 · 選用"
          }
        }
      }
    },
    "Accurate": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "精準"
          }
        }
      }
    },
    "Accurate (Qwen3-ASR-1.7B-8bit)": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "精準（Qwen3-ASR-1.7B-8bit）"
          }
        }
      }
    },
    "Achievement unlocked 🎉": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "解鎖成就 🎉"
          }
        }
      }
    },
    "Achievements": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "成就"
          }
        }
      }
    },
    "Actions": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "動作"
          }
        }
      }
    },
    "Activity": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "活動"
          }
        }
      }
    },
    "Add": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "新增"
          }
        }
      }
    },
    "Add app…": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "新增 App…"
          }
        }
      }
    },
    "Add term": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "新增詞條"
          }
        }
      }
    },
    "Adjust the current position in the recording.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "調整錄音目前的播放位置。"
          }
        }
      }
    },
    "Advanced": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "進階"
          }
        }
      }
    },
    "After transcription, an on-device language model rewrites the text — fixing fillers, grammar, and punctuation — before you insert it.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "轉錄後，裝置端語言模型會先改寫文字，修正贅詞、文法與標點，再供你插入。"
          }
        }
      }
    },
    "After you enable it in System Settings, this updates on its own.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在「系統設定」中啟用後，這裡會自動更新。"
          }
        }
      }
    },
    "Already downloaded": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已下載"
          }
        }
      }
    },
    "An interrupted-save manifest already exists at %@. Reopen ThinkAloud so it can reconcile that save before recording again.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "中斷儲存的復原資訊檔已存在於 %@。請重新開啟 ThinkAloud，讓 App 先完成該次儲存的復原，再次錄音。"
          }
        }
      }
    },
    "Analyzing & cleaning… (the first run downloads the denoiser)": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "分析與清理中…（首次執行會下載降噪器）"
          }
        }
      }
    },
    "Another dataset deletion is already in progress. Wait for it to finish and try again.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "另一項資料集刪除作業正在進行中。請等待完成後再試一次。"
          }
        }
      }
    },
    "Another interrupted-save recovery is already in progress. Wait for it to finish and try again.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "另一項中斷儲存復原作業正在進行中。請等待完成後再試一次。"
          }
        }
      }
    },
    "App language": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "介面語言"
          }
        }
      }
    },
    "Apple Intelligence": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence"
          }
        }
      }
    },
    "Apple Intelligence isn't available on this Mac; using a downloaded model.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這台 Mac 無法使用 Apple Intelligence；改用已下載的模型。"
          }
        }
      }
    },
    "Apple Intelligence isn't available right now.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence 目前無法使用。"
          }
        }
      }
    },
    "Applied to every app without its own override. The system prompt steers how the model rewrites your dictation.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "套用至所有沒有個別覆寫設定的 App。系統提示會引導模型如何改寫你的口述內容。"
          }
        }
      }
    },
    "Approve ThinkAloud in System Settings → General → Login Items to enable this.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請在「系統設定 → 一般 → 登入項目」中允許 ThinkAloud 以啟用此功能。"
          }
        }
      }
    },
    "Assumes typing ≈ %lld Latin / %lld CJK characters per minute.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Assumes typing ≈ %1$lld Latin / %2$lld CJK characters per minute."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "假設打字速度約為每分鐘 %lld 個拉丁字元／%lld 個中日韓字元。"
          }
        }
      }
    },
    "Audio cleanup": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "音訊清理"
          }
        }
      }
    },
    "Audio cleanup couldn’t be prepared. Choose Off, or check Audio Cleanup settings and retry.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法準備音訊清理。請選擇「關閉」，或檢查「音訊清理」設定後再試一次。"
          }
        }
      }
    },
    "Audio cleanup failed": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "音訊清理失敗"
          }
        }
      }
    },
    "Audio cleanup failed. Retry or choose Auto/Off in Output settings.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "音訊清理失敗。請重試，或在「輸出」設定中選擇「自動」或「關閉」。"
          }
        }
      }
    },
    "Audio cleanup is set to On, so ThinkAloud stopped instead of transcribing uncleaned audio. Retry, or change Audio cleanup to Auto or Off.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "音訊清理設為「開啟」，因此 ThinkAloud 已停止作業，而未轉錄未清理的音訊。請重試，或將音訊清理改為「自動」或「關閉」。"
          }
        }
      }
    },
    "Audio error: %@": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "音訊錯誤：%@"
          }
        }
      }
    },
    "Audio preparation failed": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "音訊準備失敗"
          }
        }
      }
    },
    "Audio size": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "音訊大小"
          }
        }
      }
    },
    "Auto": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "自動"
          }
        }
