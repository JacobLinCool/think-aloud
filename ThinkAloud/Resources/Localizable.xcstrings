    },
    "%@ ThinkAloud couldn’t save this session to local Insights history. Retry saves only the history and will not insert the text again. Closing discards this session from Insights.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ThinkAloud 無法將此工作階段儲存至本機「洞察」紀錄。重試只會儲存紀錄，不會再次插入文字。關閉會從「洞察」捨棄此工作階段。"
          }
        }
      }
    },
    "Retry History Save": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "重試儲存紀錄"
          }
        }
      }
    },
    "Local saves need attention": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "本機儲存需要處理"
          }
        }
      }
    },
    "ThinkAloud couldn’t save this session to Insights history. %@ Retry saves only the missing local data and will not insert the text again. Closing discards the missing Insights session.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "ThinkAloud 無法將此工作階段儲存至「洞察」紀錄。%@ 重試只會儲存缺少的本機資料，不會再次插入文字。關閉會捨棄缺少的「洞察」工作階段。"
          }
        }
      }
    },
    "Retry Saves": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "重試儲存"
          }
        }
      }
    },
    "Retry Insert": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "重試插入"
          }
        }
      }
    },
    "The first Insert snapshot is locked while you retry delivery.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "重試交付時，第一次插入的文字快照會保持鎖定。"
          }
        }
      }
    },
    "Full transcripts stay on this Mac. Audio is saved only when you choose Insert & Save.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "完整轉錄文字只保留在這部 Mac。只有選擇「插入並儲存」時才會保存音訊。"
          }
        }
      }
    },
    "finished with no manual edits": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "完成時沒有手動編輯"
          }
        }
      }
    },
    "%lld of %lld finished with no edits": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$lld 次中有 %1$lld 次完成時未經編輯"
          }
        }
      }
    },
    "Based on %lld Insert attempts with a measured length, including failed delivery attempts.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "根據 %lld 次有測得錄音長度的插入嘗試估算，包含交付失敗的嘗試。"
          }
        }
      }
    },
    "Your insights appear after your first Insert": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "第一次插入後就會顯示洞察"
          }
        }
      }
    },
    "Press the hotkey, dictate, then choose Insert or Insert & Save. Usage, time saved, and accuracy will appear here.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "按下快速鍵並開始口述，接著選擇「插入」或「插入並儲存」。使用次數、節省時間與準確度會顯示在這裡。"
          }
        }
      }
    },
    "Full transcripts stay on this Mac. Audio is saved only when you add a recording to Dataset.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "完整轉錄文字只保留在這部 Mac。只有將錄音加入「資料集」時才會保存音訊。"
          }
        }
      }
    },
    "Saving Session & Dataset…": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "正在儲存工作階段與資料集⋯"
          }
        }
      }
    },
    "Saving Session…": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "正在儲存工作階段⋯"
          }
        }
      }
    },
    "The text was already inserted. ThinkAloud is retrying only the local saves.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "文字已插入。ThinkAloud 只會重試本機儲存。"
          }
        }
      }
    },
    "The delivery attempt is complete. ThinkAloud is retrying only the local saves.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "交付嘗試已完成。ThinkAloud 只會重試本機儲存。"
          }
        }
      }
    },
    "The delivery attempt is complete. ThinkAloud is retrying only Insights history.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "交付嘗試已完成。ThinkAloud 只會重試儲存「洞察」紀錄。"
