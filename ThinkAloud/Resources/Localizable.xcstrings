    },
    "ThinkAloud couldn’t open its local data. The database was left unchanged. Check that Application Support is available and writable, then retry.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "ThinkAloud 無法開啟本機資料。資料庫未受變更。請確認「Application Support」可用且可寫入，然後再試一次。"
          }
