      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "「載入」會將模型保留在記憶體中，以便立即轉錄；「卸載」則會釋放模型。「閒置時自動釋放」會在所選閒置時間後釋放權重，並在下次使用時重新載入。"
          }
        }
      }
    },
