    "Smallest and fastest. Best for low-RAM Macs and casual cleanup.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "體積最小、速度最快。最適合記憶體較少的 Mac 與一般文字整理。"
          }
        }
      }
    },
